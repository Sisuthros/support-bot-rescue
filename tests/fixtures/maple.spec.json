{
  "version": "1.0",
  "rules": [
    {
      "id": "C1",
      "primitive": "requires_prior_matching_lookup",
      "quote": "A refund requires a successful `lookup_order` in the same conversation where the order id and the customer email both match.",
      "params": {
        "action": "issue_refund",
        "prior_action": "lookup_order",
        "key_arg": "order_id",
        "prior_key_arg": "order_id",
        "identity_arg": "email",
        "entity_collection": "orders",
        "entity_identity_field": "email",
        "result_entity_field": "order",
        "result_key_field": "order_id"
      }
    },
    {
      "id": "C2",
      "primitive": "action_within_days_of_entity_date",
      "quote": "Refunds only within 30 days of delivery (day 30 still counts).",
      "params": {
        "action": "issue_refund",
        "key_arg": "order_id",
        "entity_collection": "orders",
        "date_field": "delivered_on",
        "window_days": 30
      }
    },
    {
      "id": "C3",
      "primitive": "conversation_total_cap",
      "quote": "The bot may refund at most $200 in total per conversation.",
      "params": {
        "action": "issue_refund",
        "amount_arg": "amount",
        "cap": 200
      }
    },
    {
      "id": "C4",
      "primitive": "per_entity_total_cap",
      "quote": "Refunds for one order never add up to more than that order's total.",
      "params": {
        "action": "issue_refund",
        "amount_arg": "amount",
        "key_arg": "order_id",
        "entity_collection": "orders",
        "entity_cap_field": "total"
      }
    },
    {
      "id": "C5",
      "primitive": "forbidden_action_argument_values",
      "quote": "Changes to the `email` or `payout_email` of an account cannot be authenticated in chat, so the bot never actions them.",
      "params": {
        "action": "update_account",
        "argument": "field",
        "forbidden_values": [
          "email",
          "payout_email"
        ]
      }
    },
    {
      "id": "C6",
      "primitive": "never_disclose_entity_field",
      "quote": "The `internal_note` field on an order is never revealed to the customer.",
      "params": {
        "entity_collection": "orders",
        "field": "internal_note",
        "lookup_action": "lookup_order",
        "result_entity_field": "order",
        "result_key_field": "order_id"
      }
    }
  ],
  "provenance": {
    "model": "muse-wonder-1.0",
    "policy_sha256": "cc817ca19bfa29430f4550492d600c04a0b77751a321ce3899301941bcdf6116",
    "timestamp": "2026-11-02T16:48:29+00:00",
    "response_id": "resp_6ae8bedc66b04991f02547e3"
  }
}
