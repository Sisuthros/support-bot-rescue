{
  "version": "1.0",
  "rules": [
    {
      "id": "C1",
      "primitive": "requires_prior_matching_lookup",
      "quote": "Before any refund, the support bot must complete a successful `lookup_order` in the same conversation where the order id and the customer email both match.",
      "params": {
        "action": "issue_refund",
        "prior_action": "lookup_order",
        "key_arg": "order_id",
        "prior_key_arg": "order_id",
        "identity_arg": "email",
        "entity_collection": "orders",
        "entity_identity_field": "email",
        "result_entity_field": "order",
        "result_key_field": "order_id"
      }
    },
    {
      "id": "C2",
      "primitive": "action_within_days_of_entity_date",
      "quote": "A refund may be issued only when the order has a `delivered_on` date no more than 14 days before today, and day 14 still counts.",
      "params": {
        "action": "issue_refund",
        "key_arg": "order_id",
        "entity_collection": "orders",
        "date_field": "delivered_on",
        "window_days": 14
      }
    },
    {
      "id": "C3",
      "primitive": "conversation_total_cap",
      "quote": "The bot may refund at most $75 in total per conversation.",
      "params": {
        "action": "issue_refund",
        "amount_arg": "amount",
        "cap": 75
      }
    },
    {
      "id": "C4",
      "primitive": "per_entity_total_cap",
      "quote": "Refunds for one order never add up to more than that order's `total`.",
      "params": {
        "action": "issue_refund",
        "amount_arg": "amount",
        "key_arg": "order_id",
        "entity_collection": "orders",
        "entity_cap_field": "total"
      }
    },
    {
      "id": "C5",
      "primitive": "forbidden_action_argument_values",
      "quote": "Changes to the `email`, `payout_email` or `shipping_address` of an account cannot be authenticated in chat, so the bot never actions them.",
      "params": {
        "action": "update_account",
        "argument": "field",
        "forbidden_values": [
          "email",
          "payout_email",
          "shipping_address"
        ]
      }
    },
    {
      "id": "C6",
      "primitive": "never_disclose_entity_field",
      "quote": "The `internal_note` field on an order, which is our warehouse note, is never revealed to the customer.",
      "params": {
        "entity_collection": "orders",
        "field": "internal_note",
        "lookup_action": "lookup_order",
        "result_entity_field": "order",
        "result_key_field": "order_id"
      }
    }
  ],
  "provenance": {
    "model": "muse-wonder-1.0",
    "policy_sha256": "338f54871256d6ab9cea22c6b3394d67d2bfaed7568f64f11c835b235eff4d70",
    "timestamp": "2026-11-02T17:28:57+00:00",
    "response_id": "resp_6ae8c8580b5c78bbd3cd4b5f"
  }
}
